# https://editorconfig.org
# Keeps editors from rewriting files wholesale on save. The line-ending rule is
# the important one: a stray LF -> CRLF conversion rewrites every line and buries
# real changes in the diff.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# trailing spaces are a hard line break in Markdown
trim_trailing_whitespace = false
